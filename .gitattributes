# Line endings: normalise text in the repo; keep scripts and Unity YAML on LF so Windows checkouts don't break them.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.cs text eol=lf diff=csharp
*.json text eol=lf
*.md text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Unity YAML (merge with UnityYAMLMerge once it is set up as a git merge driver)
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.dll binary
