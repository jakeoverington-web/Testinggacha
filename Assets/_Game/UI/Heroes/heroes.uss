.heroes { flex-grow: 1; }
.grid { flex-grow: 1; flex-basis: 0; margin: 6px 0; }
.grid .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.card { width: 180px; height: 260px; margin: 6px; padding: 8px; border-radius: 4px; justify-content: space-between;
        border-width: 3px; border-color: rgba(0, 0, 0, 0); }
.card--slot { height: 220px; border-color: var(--gold); }
.card--empty { background-color: var(--panel); border-color: var(--line); justify-content: center; }
.card--diamond { border-color: #8FD6FF; }
.card__name { font-size: 26px; color: #FFFFFF; -unity-font-style: bold; white-space: normal; }
.card__meta { font-size: 22px; color: #F0F0F0; white-space: normal; }
.card__stars { font-size: 24px; color: #FFE38A; }
.card__stars--diamond { color: #8FD6FF; }
.tabs { flex-direction: row; justify-content: center; margin: 6px 0; }
.tab { min-width: 140px; min-height: 90px; font-size: 28px; margin: 4px; color: var(--text); background-color: var(--panel);
       border-color: var(--line); border-width: 2px; border-radius: 4px; }
.tab--on { border-color: var(--gold); color: var(--gold); }
