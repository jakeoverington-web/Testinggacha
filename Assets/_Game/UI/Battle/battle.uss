.battle { flex-grow: 1; justify-content: space-between; }
/* Side view (decisions row 16): the sim field is 16 wide x 6 deep, so the stage is a wide band, not the whole portrait screen. */
.field { height: 640px; margin: 16px 0; background-color: #121216; border-color: var(--line); border-width: 1px; }
.token { position: absolute; width: 124px; height: 104px; translate: -50% -50%; border-radius: 4px; padding: 4px;
         justify-content: space-between; border-width: 3px; border-color: rgba(0, 0, 0, 0); }
.token--enemy { border-color: #000000; }
.token--dead { opacity: 0.2; }
.token--summon { width: 100px; height: 70px; }
.token__name { font-size: 20px; color: #FFFFFF; -unity-font-style: bold; white-space: normal; }
.bar-hp { height: 12px; background-color: #300; }
.bar-hp__fill { height: 100%; background-color: var(--good); }
.bar-en { height: 8px; margin-top: 2px; background-color: #222; }
.bar-en__fill { height: 100%; background-color: #E8C35A; }
/* Bottom row: your heroes. In manual mode a full-energy portrait grows into a tall card; tap it to cast (redesign spec). */
.portraits { flex-direction: row; justify-content: center; align-items: flex-end; height: 420px; }
.portrait { width: 180px; height: 220px; margin: 6px; padding: 8px; border-radius: 4px; justify-content: space-between;
            border-width: 3px; border-color: var(--line); transition-property: height; transition-duration: 0.2s; }
.portrait--dead { opacity: 0.25; }
.portrait--ready { height: 400px; border-color: var(--gold); }
.portrait__name { font-size: 24px; color: #FFFFFF; -unity-font-style: bold; white-space: normal; }
.portrait__ult { font-size: 30px; color: var(--ink); background-color: var(--gold); -unity-text-align: middle-center;
                 -unity-font-style: bold; border-radius: 4px; display: none; }
.portrait--ready .portrait__ult { display: flex; }
