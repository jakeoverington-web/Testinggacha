.result { flex-grow: 1; justify-content: center; }
.outcome { font-size: 96px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 24px; }
.outcome--win { color: var(--gold); }
.outcome--loss { color: var(--bad); }
.result__buttons { margin-top: 48px; }
.stats-button { align-self: center; margin-top: 24px; }
/* After-fight statistics (owner, 2026-10-03): tap to open, so not a pop-up (row 15). */
.stats-panel { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--ink); padding: 24px 0; display: none; }
.stats-panel--open { display: flex; }
.tab { min-width: 220px; min-height: 100px; font-size: 32px; margin: 4px; color: var(--text); background-color: var(--panel);
       border-color: var(--line); border-width: 2px; border-radius: 4px; }
.tab--on { border-color: var(--gold); color: var(--gold); }
.stats-legend { flex-direction: row; justify-content: center; margin: 8px 0; }
.legend { font-size: 26px; margin: 0 12px; }
.legend--dealt { color: #E0745A; }
.legend--heal { color: #6FBF73; }
.legend--taken { color: #8C9AA8; }
.stats-rows { flex-grow: 1; flex-basis: 0; }
.stat-hero { flex-direction: row; align-items: center; margin: 10px 0; padding: 8px; background-color: var(--panel); border-radius: 4px; }
.stat-hero__icon { width: 150px; height: 150px; border-radius: 4px; justify-content: space-between; padding: 6px; }
/* Fallen: the colour behind is greyed in code; the text stays at full brightness. */
.stat-hero__name { font-size: 24px; color: #FFFFFF; -unity-font-style: bold; white-space: normal; }
.stat-hero__died { font-size: 24px; color: #FF7A7A; -unity-font-style: bold; display: none; background-color: rgba(0, 0, 0, 0.55);
                   border-radius: 3px; padding: 2px 6px; -unity-text-align: middle-center; }
.stat-hero--fallen .stat-hero__died { display: flex; }
.stat-hero__bars { flex-grow: 1; margin-left: 16px; }
.stat-bar { flex-direction: row; align-items: center; height: 40px; margin: 3px 0; }
.stat-bar__track { flex-grow: 1; height: 26px; background-color: #1C1C21; }
.stat-bar__fill { height: 100%; }
.stat-bar__fill--dealt { background-color: #E0745A; }
.stat-bar__fill--heal { background-color: #6FBF73; }
.stat-bar__fill--taken { background-color: #8C9AA8; }
.stat-bar__value { width: 150px; font-size: 26px; color: var(--text); -unity-text-align: middle-right; }
